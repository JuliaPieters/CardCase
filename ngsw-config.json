{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js", "/catalog.json", "/firebase-config.json", "/icons/**"]
      }
    },
    {
      "name": "scanner",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/card-hashes.bin"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "prices",
      "urls": ["https://api.tcgdex.net/**"],
      "cacheConfig": {
        "strategy": "freshness",
        "timeout": "4s",
        "maxAge": "7d",
        "maxSize": 3000
      }
    }
  ]
}
