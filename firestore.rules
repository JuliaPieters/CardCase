rules_version = '2';

// Paste into Firebase console → Firestore Database → Rules, then Publish.
// Each signed-in user can only read and write their own document users/{uid} and its pictures; everything else is closed.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Pictures uploaded for binders, one per document (a binder document can't hold them).
      match /images/{img} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
